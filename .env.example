# Local, synthetic-data prototype. No OpenAI key is needed for the UI or portal.
# Optional absolute path for the portal SQLite database:
# RELAY_PORTAL_DB=/absolute/path/to/portal.sqlite

# Application key for the agent adapter (server only):
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-6-astra

# Optional worker settings (the demo launcher matches its chosen port):
# RELAY_BASE_URL=http://127.0.0.1:3100
# RELAY_CASE_DB=/absolute/path/to/cases.sqlite
# RELAY_BROWSER_CHANNEL=chrome
